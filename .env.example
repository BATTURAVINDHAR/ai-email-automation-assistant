# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git — it's already in .gitignore.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Gmail API ---
# Path to the OAuth client secret file you download from Google Cloud
# Console (APIs & Services > Credentials > Create OAuth client ID > Desktop app).
GMAIL_CREDENTIALS_PATH=credentials.json
# Where the auto-generated login token gets cached after first run.
GMAIL_TOKEN_PATH=token.json

# --- Behavior ---
POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_RUN=10
# If "false" (recommended while testing), the assistant only DRAFTS
# replies in the logs — it never actually sends them.
AUTO_SEND_REPLIES=false

# --- Logging ---
LOG_LEVEL=INFO
